#!/usr/bin/env node

/**
 * Module dependencies.
 */

const fs = require('fs');
var db = require('../utils/mssqldb');
// var debug = require('debug')('etraingserver:server');
var http = require('http');
var https = require('https');

process.on('unhandledRejection', function (reason) {
  if (db.isDatabaseError(reason)) {
    console.error('Unhandled database operation failed; service will continue:', reason);
    return;
  }

  // Do not conceal programming errors or unrelated infrastructure failures.
  setImmediate(function () {
    throw reason instanceof Error ? reason : new Error(String(reason));
  });
});

var app = require('../app');

/**
 * Get port from environment and store in Express.
 */
var privateKey  = fs.readFileSync('users/public/SSL/key.key', 'utf8');
var certificate = fs.readFileSync('users/public/SSL/pem.pem', 'utf8');
var credentials = {key: privateKey, cert: certificate};

var port = normalizePort(process.env.PORT || '8081');
var ports = normalizePort(process.env.PORTS || '8080');
// app.set('port', port);
// app.set('porthttps',8081) 

/**
 * Create HTTP server.
 */

var server = http.createServer(app);
var servers = https.createServer(credentials, app);

/**
 * Listen on provided port, on all network interfaces.
 */

// server.listen(port);
// server.on('error', onError);
// server.on('listening', onListening);

server.listen(port);
servers.listen(ports);
// server.on('error', onError);
// server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}
